# ==========================================
# KROSS KOREA — backend sozlamalari (namuna)
# Nusxa oling: .env  (git'ga qo'shilmaydi)
# ==========================================

# Neon PostgreSQL ulanish manzili
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# BotFather'dan olingan token
BOT_TOKEN=

# Bot rejimi: polling (kompyuter / Render) yoki webhook (serverless)
BOT_MODE=polling

# Adminlar Telegram ID'lari, vergul bilan (masalan: 123456789,987654321)
ADMIN_IDS=

# Botda /admin PAROL va panelga kirish paroli (kamida 10 belgi)
ADMIN_PASSWORD=

# Admin token kaliti — uzun tasodifiy satr
JWT_SECRET=

# Mini ilova manzili (https bo'lishi shart — Telegram talabi)
WEB_APP_URL=

# Backend'ning tashqi manzili (uyg'oq turish uchun o'ziga so'rov yuboradi)
PUBLIC_URL=

# Faqat localhost uchun test rejimi: initData tekshirilmaydi
SKIP_INITDATA_CHECK=false
DEV_TELEGRAM_ID=

PORT=4000
